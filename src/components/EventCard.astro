---
import { eventState, STATE_LABEL, seatsLeft, fmtDay, fmtMonth, fmtTime, type EventRow } from '../lib/util';

interface Props { e: EventRow; }
const { e } = Astro.props;
const st = eventState(e);
const left = seatsLeft(e);
const badge: Record<string, string> = {
  open: 'bg-[#d9f7e3] text-[#0f6b34]', full: 'bg-[#ffe3e8] text-[#a3182f]',
  closed: 'bg-[#fff1cc] text-[#8a5a00]', past: 'bg-[#e8eef3] text-[#44596a]',
};
---
<a href={`/eventos/${e.slug}`} class="spot group flex flex-col h-full">
  <div class="relative overflow-hidden aspect-[16/10] bg-[linear-gradient(135deg,#0a9ddb,#2f8cff)]">
    {e.image_url
      ? <img src={e.image_url} alt="" width="1400" height="875" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
      : <div class="size-full grid place-items-center"><img src="/img/simbolo-vortice-blanco.png" alt="" width="261" height="256" class="h-24 w-auto opacity-90" /></div>}
    <div class="absolute left-4 top-4 rounded-2xl bg-white px-3.5 py-2 text-center leading-none shadow-lg">
      <span class="block font-display text-3xl text-[#0d2f4a]">{fmtDay(e.starts_at)}</span>
      <span class="block mt-1 text-[11px] font-extrabold uppercase tracking-widest text-[color:var(--pt)]">{fmtMonth(e.starts_at)}</span>
    </div>
  </div>
  <div class="p-6 flex flex-col flex-1">
    <span class={`self-start text-xs font-extrabold px-3 py-1 rounded-full ${badge[st]}`}>
      {STATE_LABEL[st]}{st === 'open' && left != null && left <= 10 ? ` · ${left} plaza${left === 1 ? '' : 's'}` : ''}
    </span>
    <h3 class="mt-3 text-2xl">{e.title}</h3>
    {e.summary && <p class="mt-2 text-mute">{e.summary}</p>}
    <p class="mt-3 text-sm font-semibold text-mute">{fmtTime(e.starts_at)} h{e.location ? ` · ${e.location}` : ''}</p>
    <span class="mt-auto pt-5 font-bold">{st === 'open' ? 'Ver y apuntarme →' : 'Ver evento →'}</span>
  </div>
</a>
