---
import { SITE } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/#servicios', label: 'Servicios', match: '/servicios' },
  { href: '/adventrix', label: 'Adventrix', match: '/adventrix' },
  { href: '/nosotros', label: 'Nosotros', match: '/nosotros' },
  { href: '/blog', label: 'Blog', match: '/blog' },
  { href: '/contacto', label: 'Contacto', match: '/contacto' },
];
---
<div id="progress" aria-hidden="true"></div>
<header class="fixed top-4 inset-x-0 z-50 flex justify-center px-3 pointer-events-none">
  <div class="relative pointer-events-auto">
    <nav id="pill" aria-label="Principal" class="glass rounded-full flex items-center gap-1 sm:gap-2 pl-2 pr-2 py-2">
      <a href="/" class="flex items-center gap-2 pl-2 pr-3 font-display text-xl text-[#eef6ff]" aria-label="Vórtice Eventos, inicio">
        <img src="/img/logo-vortice.png" alt="" width="36" height="32" class="h-8 w-auto drop-shadow-[0_0_12px_rgba(25,181,255,.6)]" />
        <span class="hidden sm:inline">Vórtice</span>
      </a>
      <div class="links relative hidden md:flex items-center">
        <span class="nav-ind" aria-hidden="true"></span>
        {links.map((l) => (
          <a data-nav href={l.href} class="nav-link" aria-current={path.startsWith(l.match) ? 'page' : undefined}>{l.label}</a>
        ))}
      </div>
      <a href="/contacto" class="btn btn-primary mag !py-2.5 !px-5 text-sm ml-1">Presupuesto</a>
      <button id="burger" class="md:hidden grid place-items-center size-10 rounded-full glass" aria-expanded="false" aria-controls="mmenu" aria-label="Abrir menú">
        <span class="block w-4 h-0.5 bg-white rounded relative before:content-[''] before:absolute before:w-4 before:h-0.5 before:bg-white before:-top-1.5 after:content-[''] after:absolute after:w-4 after:h-0.5 after:bg-white after:top-1.5"></span>
      </button>
    </nav>
    <div id="mmenu" hidden class="md:hidden absolute left-1/2 -translate-x-1/2 mt-3 w-[min(92vw,22rem)] glass !bg-[#06101f]/95 text-[#eef6ff] rounded-[2rem] p-3 shadow-2xl">
      <ul class="grid gap-1">
        {links.map((l) => <li><a href={l.href} class="block rounded-2xl px-5 py-3.5 font-display text-2xl hover:bg-white/10">{l.label}</a></li>)}
        <li><a href={SITE.phoneHref} class="block rounded-2xl px-5 py-3 text-[#9db3c9] font-semibold">📞 {SITE.phone}</a></li>
      </ul>
    </div>
  </div>
</header>
