---
// Campo de imagen del panel: pegar una URL o subir una foto (se reduce en el navegador antes de subir).
interface Props { name: string; value?: string | null; label: string; }
const { name, value = '', label } = Astro.props;
---
<div class="grid gap-2" data-imgfield>
  <span class="text-sm font-bold">{label}</span>
  <div class="flex flex-wrap items-start gap-4">
    <div class="size-28 rounded-2xl border-2 border-[var(--accl)] bg-white overflow-hidden grid place-items-center text-xs text-mute shrink-0">
      <img data-preview src={value || ''} alt="" class={`size-full object-cover ${value ? '' : 'hidden'}`} />
      <span data-empty class={value ? 'hidden' : ''}>Sin foto</span>
    </div>
    <div class="grid gap-2 grow min-w-[16rem]">
      <input class="field" name={name} value={value ?? ''} placeholder="https://… o sube una foto" data-url />
      <div class="flex flex-wrap items-center gap-3">
        <label class="btn btn-dark !py-2 !px-4 text-sm cursor-pointer">
          Subir foto
          <input type="file" accept="image/*" class="sr-only" data-file />
        </label>
        <button type="button" class="text-sm font-bold text-[#d9304f] hover:underline" data-clear>Quitar</button>
        <span class="text-sm text-mute" data-status role="status"></span>
      </div>
    </div>
  </div>
</div>
<script is:inline>
  document.querySelectorAll('[data-imgfield]').forEach(function (box) {
    if (box.dataset.ready) return; box.dataset.ready = '1';
    var url = box.querySelector('[data-url]'), file = box.querySelector('[data-file]'),
        prev = box.querySelector('[data-preview]'), empty = box.querySelector('[data-empty]'),
        st = box.querySelector('[data-status]');
    function show() { var v = url.value.trim(); if (v) { prev.src = v; prev.classList.remove('hidden'); empty.classList.add('hidden'); } else { prev.removeAttribute('src'); prev.classList.add('hidden'); empty.classList.remove('hidden'); } }
    url.addEventListener('input', show);
    box.querySelector('[data-clear]').addEventListener('click', function () { url.value = ''; show(); st.textContent = ''; });
    file.addEventListener('change', async function () {
      var f = file.files && file.files[0]; if (!f) return;
      st.textContent = 'Subiendo…';
      try {
        var blob = f;
        if (/^image\/(jpeg|png|webp)$/.test(f.type)) {
          var bmp = await createImageBitmap(f), max = 1600, k = Math.min(1, max / Math.max(bmp.width, bmp.height));
          var c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
          c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
          blob = await new Promise(function (ok) { c.toBlob(ok, 'image/webp', 0.85); }) || f;
        }
        var fd = new FormData(); fd.append('file', blob, f.name.replace(/\.[^.]+$/, '') + (blob.type === 'image/webp' ? '.webp' : ''));
        var r = await fetch('/api/admin/upload', { method: 'POST', body: fd }), j = await r.json();
        if (!r.ok) throw new Error(j.error || 'Error al subir');
        url.value = j.url; show(); st.textContent = 'Foto subida ✓';
      } catch (e) { st.textContent = e.message || 'No se pudo subir la foto.'; }
      file.value = '';
    });
  });
</script>
