---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../data/site';

const mapQ = encodeURIComponent(`${SITE.street}, ${SITE.postal} ${SITE.city}, España`);

const channels = [
  { t: 'Llámanos', v: SITE.phone, h: SITE.phoneHref, cls: 'bg-[#0a7bb0] text-white', sh: '#076f9a',
    icon: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z' },
  { t: 'WhatsApp', v: 'Escríbenos ahora', h: SITE.whatsapp, cls: 'bg-[#ffc933] text-[#0d2f4a]', sh: '#d99e00',
    icon: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3zm4.6 12.4c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-3.2-.8a10.9 10.9 0 0 1-4.1-3.6c-.7-1-1.2-2-1.2-3s.5-1.5.7-1.7c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4l.7 1.7c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.4.7 1 1.4 1.7 1.9.7.5 1.3.8 1.6.9.3.1.5.1.6-.1l.8-.9c.2-.2.4-.2.6-.1l1.7.8c.2.1.4.2.4.3.1.2.1.7-.1 1.3z' },
  { t: 'Email', v: SITE.email, h: `mailto:${SITE.email}`, cls: 'bg-[#0d2f4a] text-white', sh: '#061a2b',
    icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm9 7.2L4.5 7v.1L12 13l7.5-5.9V7z' },
  { t: 'Instagram', v: '@vortice_eventos', h: SITE.instagram, cls: 'bg-white text-[#0d2f4a] border-2 border-[#cfe9f7]', sh: '#cfe9f7',
    icon: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.2-1.7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z' },
];
const steps = [
  ['1', 'Nos cuentas', 'Qué quieres celebrar, cuántos sois y cuándo.'],
  ['2', 'Te respondemos', 'En menos de 24 horas, con una propuesta.'],
  ['3', 'Lo hacemos realidad', 'Presupuesto a medida, sin compromiso.'],
];
---
<Base
  title="Contacto y presupuesto de eventos en Toledo | Vórtice"
  description="Pide presupuesto sin compromiso para tu evento en Toledo. Llámanos al 696 035 857, escríbenos por WhatsApp o visítanos en Calle Alegría 48."
>
  <!-- Hero -->
  <section class="relative overflow-hidden pt-36 pb-44 md:pb-40 text-center">
    <div class="aurora" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
    <div class="relative z-10 mx-auto max-w-4xl px-5">
      <p class="reveal inline-flex glass rounded-full px-4 py-1.5 text-sm font-bold text-[color:var(--pt)]">Presupuesto sin compromiso</p>
      <h1 class="reveal mt-5 text-[clamp(3.2rem,9vw,7rem)] leading-[0.95]" style="--delay:80ms">¿Hablamos de tu <em>evento</em>?</h1>
      <p class="reveal mt-5 text-xl text-mute max-w-xl mx-auto" style="--delay:160ms">Elige cómo prefieres contactarnos. Respondemos en menos de 24 horas.</p>
    </div>
  </section>

  <!-- Canales (solapan el hero) -->
  <section class="relative z-10 mx-auto max-w-6xl px-5 -mt-32 md:-mt-28">
    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {channels.map((c, i) => (
        <li class="reveal" style={`--delay:${i * 80}ms`}>
          <a href={c.h} rel="noopener" class={`group block rounded-[1.75rem] p-5 md:p-7 h-full transition-transform hover:translate-y-[3px] ${c.cls}`} style={`box-shadow:0 10px 0 -3px ${c.sh}`}>
            <svg viewBox="0 0 24 24" class="size-9 md:size-11" fill="currentColor" aria-hidden="true"><path d={c.icon} /></svg>
            <span class="mt-4 block font-display text-2xl md:text-3xl">{c.t}</span>
            <span class="mt-1 block text-sm md:text-base font-semibold break-words">{c.v}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Formulario + mapa -->
  <section class="mx-auto max-w-6xl px-5 pt-24 grid gap-8 lg:grid-cols-5 items-start">
    <div class="lg:col-span-3">
      <h2 class="reveal text-4xl md:text-5xl">Cuéntanos tu <em>idea</em></h2>
      <p class="reveal mt-3 text-mute" style="--delay:80ms">Rellena lo que sepas, con eso ya empezamos a prepararte una propuesta.</p>
      <div class="reveal mt-7" style="--delay:140ms"><ContactForm /></div>
    </div>

    <aside class="lg:col-span-2 grid gap-5">
      <div class="reveal rounded-[1.75rem] overflow-hidden border-4 border-white shadow-[0_18px_40px_-20px_rgba(13,47,74,.6)] aspect-[4/3] bg-[#d8f0fc]">
        <iframe title="Mapa: Vórtice Eventos, Calle Alegría 48, Toledo" src={`https://www.google.com/maps?q=${mapQ}&output=embed`} class="size-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="reveal spot p-6" style="--delay:80ms">
        <p class="text-xs font-extrabold tracking-[0.18em] uppercase text-[color:var(--pt)]">Visítanos</p>
        <p class="mt-1 font-display text-2xl">{SITE.street}</p>
        <p class="text-mute">{SITE.postal} {SITE.city}</p>
        <a class="mt-3 inline-block font-bold text-[color:var(--pt)] underline underline-offset-4" href={`https://www.google.com/maps/search/?api=1&query=${mapQ}`} rel="noopener">Cómo llegar ↗</a>
      </div>
      <ol class="reveal grid gap-3" style="--delay:140ms">
        {steps.map(([n, t, d]) => (
          <li class="glass rounded-2xl p-4 flex gap-4 items-center">
            <span class="grid place-items-center size-10 shrink-0 rounded-full bg-[color:var(--acc)] text-[color:var(--acc-on)] font-display text-xl">{n}</span>
            <span><strong class="block">{t}</strong><span class="text-sm text-mute">{d}</span></span>
          </li>
        ))}
      </ol>
    </aside>
  </section>
</Base>
