---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { listEventsAdmin } from '../../../lib/queries';
import { eventState, STATE_LABEL, fmtDateShort, fmtTime, seatsLeft } from '../../../lib/util';

const MSG: Record<string, string> = {
  creado: 'Evento creado.', guardado: 'Cambios guardados.', borrado: 'Evento borrado.',
  abierto: 'Inscripciones abiertas.', cerrado: 'Inscripciones cerradas.', publicado: 'Evento publicado en la web.', oculto: 'Evento oculto de la web.',
};
let flash = MSG[Astro.url.searchParams.get('msg') ?? ''] ?? '';
const n = Number(Astro.url.searchParams.get('n') ?? 0);
if (Astro.url.searchParams.get('msg') === 'pasados') flash = n ? `Se han borrado ${n} evento${n > 1 ? 's' : ''} pasado${n > 1 ? 's' : ''}.` : 'No había eventos pasados que borrar.';

let events: Awaited<ReturnType<typeof listEventsAdmin>> = [];
let error = '';

try {
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const action = String(form.get('action') ?? '');
    const id = Number(form.get('id'));
    let msg = '';
    if (action === 'toggle_open' && id) {
      const r = await sql`UPDATE events SET registration_open = NOT registration_open, updated_at = now() WHERE id = ${id} RETURNING registration_open`;
      msg = r[0]?.registration_open ? 'abierto' : 'cerrado';
    } else if (action === 'toggle_published' && id) {
      const r = await sql`UPDATE events SET published = NOT published, updated_at = now() WHERE id = ${id} RETURNING published`;
      msg = r[0]?.published ? 'publicado' : 'oculto';
    } else if (action === 'delete' && id) {
      await sql`DELETE FROM events WHERE id = ${id}`;
      msg = 'borrado';
    } else if (action === 'delete_past') {
      const r = await sql`DELETE FROM events WHERE COALESCE(ends_at, starts_at + interval '3 hours') < now() RETURNING id`;
      return Astro.redirect(`/admin/eventos?msg=pasados&n=${r.length}`);
    }
    return Astro.redirect(`/admin/eventos${msg ? `?msg=${msg}` : ''}`);
  }
  events = await listEventsAdmin();
} catch (e) {
  console.error('admin eventos', e);
  error = 'No se pudo leer la base de datos.';
}

const upcoming = events.filter((e) => eventState(e) !== 'past');
const past = events.filter((e) => eventState(e) === 'past').reverse();
const badge: Record<string, string> = {
  open: 'bg-[#d9f7e3] text-[#0f6b34]', full: 'bg-[#ffe3e8] text-[#a3182f]',
  closed: 'bg-[#fff1cc] text-[#8a5a00]', past: 'bg-[#e8eef3] text-[#44596a]',
};
---
<AdminLayout title="Eventos">
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-4xl grow">Eventos</h1>
    <a class="btn btn-primary" href="/admin/eventos/nuevo">+ Nuevo evento</a>
  </div>
  {flash && <p class="mt-4 p-3 rounded-2xl bg-[#d9f7e3] text-[#0f6b34] font-bold" role="status">{flash}</p>}
  {error && <p class="mt-4 p-3 rounded-2xl bg-[#ffe3e8] text-[#a3182f] font-bold" role="alert">{error}</p>}

  <h2 class="mt-8 text-2xl">Próximos</h2>
  {upcoming.length === 0 ? <p class="mt-3 text-mute">No hay eventos próximos.</p> : (
    <div class="mt-3 grid gap-3">
      {upcoming.map((e) => {
        const st = eventState(e); const left = seatsLeft(e);
        return (
          <article class="glass rounded-3xl p-4 md:p-5 grid gap-3 md:grid-cols-[1fr_auto] md:items-center">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <a href={`/admin/eventos/${e.id}`} class="font-display text-2xl hover:underline">{e.title}</a>
                {!e.published && <span class="text-xs font-bold px-3 py-1 rounded-full bg-[#e8eef3] text-[#44596a]">Oculto</span>}
              </div>
              <p class="text-mute text-sm">{fmtDateShort(e.starts_at)} · {fmtTime(e.starts_at)}{e.location ? ` · ${e.location}` : ''}</p>
              <p class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                <span class={`font-bold px-3 py-1 rounded-full ${badge[st]}`}>{STATE_LABEL[st]}</span>
                <strong>{e.taken}{e.capacity != null ? ` / ${e.capacity}` : ''}</strong> plazas
                {left != null && <span class="text-mute">({left} libres)</span>}
                · {e.regs} inscripción{e.regs === 1 ? '' : 'es'}
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <form method="post"><input type="hidden" name="action" value="toggle_open" /><input type="hidden" name="id" value={e.id} />
                <button class="btn btn-dark !py-2 !px-4 text-sm">{e.registration_open ? 'Cerrar inscripciones' : 'Abrir inscripciones'}</button></form>
              <form method="post"><input type="hidden" name="action" value="toggle_published" /><input type="hidden" name="id" value={e.id} />
                <button class="btn btn-white !py-2 !px-4 text-sm border-2 border-[var(--accl)]">{e.published ? 'Ocultar' : 'Publicar'}</button></form>
              <a class="btn btn-white !py-2 !px-4 text-sm border-2 border-[var(--accl)]" href={`/admin/eventos/${e.id}`}>Editar / inscritos</a>
              <form method="post" data-confirm={`¿Borrar «${e.title}» y sus ${e.regs} inscripciones? No se puede deshacer.`}>
                <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={e.id} />
                <button class="px-3 py-2 text-sm font-bold text-[#d9304f] hover:underline">Borrar</button></form>
            </div>
          </article>
        );
      })}
    </div>
  )}

  <div class="mt-10 flex flex-wrap items-center gap-3">
    <h2 class="text-2xl grow">Pasados <span class="text-mute text-lg">({past.length})</span></h2>
    {past.length > 0 && (
      <form method="post" data-confirm={`¿Borrar los ${past.length} eventos pasados y sus inscripciones? No se puede deshacer.`}>
        <input type="hidden" name="action" value="delete_past" />
        <button class="btn btn-dark !py-2 !px-4 text-sm">Borrar todos los pasados</button>
      </form>
    )}
  </div>
  <p class="mt-1 text-sm text-mute">Los eventos pasados también se borran solos 30 días después de terminar.</p>
  {past.length === 0 ? <p class="mt-3 text-mute">No hay eventos pasados.</p> : (
    <ul class="mt-3 grid gap-2">
      {past.map((e) => (
        <li class="glass rounded-2xl px-4 py-3 flex flex-wrap items-center gap-3 text-sm">
          <a class="font-bold hover:underline grow" href={`/admin/eventos/${e.id}`}>{e.title}</a>
          <span class="text-mute">{fmtDateShort(e.starts_at)}</span>
          <span>{e.regs} inscripción{e.regs === 1 ? '' : 'es'}</span>
          <form method="post" data-confirm={`¿Borrar «${e.title}» y sus inscripciones?`}>
            <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={e.id} />
            <button class="font-bold text-[#d9304f] hover:underline">Borrar</button></form>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>

