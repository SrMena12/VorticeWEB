---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sql } from '../../lib/db';
import { listEventsAdmin } from '../../lib/queries';
import { eventState, STATE_LABEL, fmtDateShort, fmtTime, seatsLeft } from '../../lib/util';

let events: Awaited<ReturnType<typeof listEventsAdmin>> = [];
let recent: any[] = [];
let posts = { total: 0, published: 0 };
let dbError = false;

try {
  events = await listEventsAdmin();
  recent = await sql`
    SELECT r.name, r.attendees, r.created_at, e.title, e.id AS event_id
      FROM registrations r JOIN events e ON e.id = r.event_id
     ORDER BY r.created_at DESC LIMIT 6`;
  const [p] = await sql`SELECT count(*)::int AS total, count(*) FILTER (WHERE published)::int AS published FROM posts`;
  posts = p as any;
} catch (e) {
  console.error('admin index', e);
  dbError = true;
}

const upcoming = events.filter((e) => eventState(e) !== 'past');
const open = upcoming.filter((e) => eventState(e) === 'open');
const totalSeats = upcoming.reduce((s, e) => s + e.taken, 0);
const badge: Record<string, string> = {
  open: 'bg-[#d9f7e3] text-[#0f6b34]', full: 'bg-[#ffe3e8] text-[#a3182f]',
  closed: 'bg-[#e8eef3] text-[#44596a]', past: 'bg-[#e8eef3] text-[#44596a]',
};
---
<AdminLayout title="Resumen">
  <h1 class="text-4xl">Resumen</h1>
  {dbError && <p class="mt-4 p-4 rounded-2xl bg-[#ffe3e8] text-[#a3182f] font-bold">No se puede leer la base de datos. Comprueba que está conectada al proyecto.</p>}

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {[
      { n: upcoming.length, l: 'Eventos próximos', href: '/admin/eventos' },
      { n: open.length, l: 'Con inscripción abierta', href: '/admin/eventos' },
      { n: totalSeats, l: 'Plazas reservadas', href: '/admin/eventos' },
      { n: `${posts.published}/${posts.total}`, l: 'Artículos publicados', href: '/admin/blog' },
    ].map((s) => (
      <a href={s.href} class="glass rounded-3xl p-5 hover:-translate-y-0.5 transition-transform">
        <div class="font-display text-5xl text-[color:var(--pt)]">{s.n}</div>
        <div class="mt-1 text-sm font-bold text-mute">{s.l}</div>
      </a>
    ))}
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    <a class="btn btn-primary" href="/admin/eventos/nuevo">+ Nuevo evento</a>
    <a class="btn btn-dark" href="/admin/blog/nuevo">+ Nuevo artículo</a>
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-5">
    <section class="lg:col-span-3">
      <h2 class="text-2xl">Próximos eventos</h2>
      {upcoming.length === 0 ? <p class="mt-3 text-mute">No hay eventos próximos. Crea el primero con el botón de arriba.</p> : (
        <ul class="mt-3 grid gap-3">
          {upcoming.slice(0, 6).map((e) => {
            const st = eventState(e); const left = seatsLeft(e);
            return (
              <li>
                <a href={`/admin/eventos/${e.id}`} class="glass rounded-2xl p-4 flex flex-wrap items-center gap-x-4 gap-y-1 hover:border-[var(--p)]">
                  <div class="grow min-w-[12rem]">
                    <div class="font-bold">{e.title}</div>
                    <div class="text-sm text-mute">{fmtDateShort(e.starts_at)} · {fmtTime(e.starts_at)}</div>
                  </div>
                  <div class="text-sm font-bold">{e.taken}{e.capacity != null ? ` / ${e.capacity}` : ''} plazas</div>
                  <span class={`text-xs font-bold px-3 py-1 rounded-full ${badge[st]}`}>{STATE_LABEL[st]}{st === 'open' && left != null ? ` · ${left} libres` : ''}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </section>
    <section class="lg:col-span-2">
      <h2 class="text-2xl">Últimas inscripciones</h2>
      {recent.length === 0 ? <p class="mt-3 text-mute">Todavía no hay inscripciones.</p> : (
        <ul class="mt-3 grid gap-2">
          {recent.map((r) => (
            <li class="glass rounded-2xl px-4 py-3 text-sm">
              <a href={`/admin/eventos/${r.event_id}`} class="hover:underline"><strong>{r.name}</strong> · {r.attendees} plaza{r.attendees > 1 ? 's' : ''}</a>
              <div class="text-mute">{r.title} · {fmtDateShort(r.created_at)} {fmtTime(r.created_at)}</div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</AdminLayout>
