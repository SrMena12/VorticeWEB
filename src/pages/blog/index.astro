---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { POSTS } from '../../data/blog';
import { listPostsPublic } from '../../lib/queries';
import { readingMinutes } from '../../lib/util';

const fallbackCovers: Record<string, string> = {
  'ideas-team-building-toledo': '/img/blog-team-building.webp',
  'como-organizar-fiesta-empresa-toledo': '/img/blog-fiesta-empresa.webp',
  'despedida-de-soltero-toledo-ideas': '/img/serv-despedidas-de-soltero-toledo.webp',
};

type Card = { slug: string; title: string; desc: string; readMin: number; cover: string };
let cards: Card[] = [];
try {
  cards = (await listPostsPublic()).map((p) => ({
    slug: p.slug, title: p.title, desc: p.description, readMin: readingMinutes(p.content), cover: p.cover_url || '/og.png',
  }));
} catch (e) {
  console.error('blog', e);
  cards = POSTS.map((p) => ({ slug: p.slug, title: p.title, desc: p.desc, readMin: p.readMin, cover: fallbackCovers[p.slug] }));
}
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---
<Base
  title="Blog de eventos en Toledo: ideas y consejos | Vórtice"
  description="Ideas, guías y consejos para organizar eventos en Toledo: team building, fiestas de empresa, despedidas y celebraciones, por Vórtice Eventos."
>
  <section class="relative overflow-hidden pt-40 pb-12">
    <div class="aurora" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span></div>
    <div class="relative z-10 mx-auto max-w-6xl px-5">
      <h1 class="reveal text-[clamp(2.8rem,7vw,6rem)]">Ideas para tus <em>eventos en Toledo</em></h1>
      <p class="reveal mt-5 text-xl text-mute max-w-2xl" style="--delay:100ms">Guías prácticas y consejos para organizar team building, fiestas de empresa, despedidas y celebraciones.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 pt-8 grid gap-5 md:grid-cols-3">
    {cards.map((p, i) => (
      <a href={`/blog/${p.slug}`} class="spot reveal group flex flex-col" style={`--delay:${i * 90}ms`}>
        <div class="overflow-hidden aspect-[16/10]"><img src={p.cover} alt="" width="1400" height="933" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
        <div class="p-6 flex flex-col flex-1">
          <span class="text-xs font-extrabold tracking-[0.18em] uppercase text-[color:var(--pt)]">{p.readMin} min de lectura</span>
          <h2 class="mt-2 text-2xl">{p.title}</h2>
          <p class="mt-3 text-mute">{p.desc}</p>
          <span class="mt-auto pt-5 font-bold">Leer artículo →</span>
        </div>
      </a>
    ))}
  </section>
</Base>
