---
export const prerender = false;
import PostView from '../../components/PostView.astro';
import NotFound from '../../components/NotFound.astro';
import { POSTS } from '../../data/blog';
import { getPostBySlug, listPostsPublic, type PostRow } from '../../lib/queries';

const slug = Astro.params.slug!;
let p: PostRow | null = null;
let others: PostRow[] = [];
try {
  p = await getPostBySlug(slug);
  if (p) others = (await listPostsPublic()).filter((x) => x.slug !== slug).slice(0, 2);
} catch (e) {
  console.error('post', e);
  // Respaldo: si la base de datos no responde, se sirven los artículos que vienen con la web.
  const s = POSTS.find((x) => x.slug === slug);
  if (s) {
    p = {
      id: 0, slug: s.slug, title: s.title, meta_title: s.metaTitle, description: s.desc, service: s.service, published: true,
      content: s.body.map((b) => (b.h ? `## ${b.h}\n\n${b.p}` : b.p)).join('\n\n'), cover_url: null, published_at: `${s.date}T10:00:00+01:00`,
    };
  }
}
if (!p) Astro.response.status = 404;
else Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---
{p ? <PostView p={p} others={others} /> : <NotFound />}
