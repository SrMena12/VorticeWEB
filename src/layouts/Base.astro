---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props { title: string; description: string; schema?: object[]; theme?: 'adv'; image?: string; ogType?: string; noindex?: boolean; }
const { title, description, schema = [], theme, image = '/og.png', ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'es-ES',
};
const business = {
  '@context': 'https://schema.org',
  '@type': 'EventPlanner',
  '@id': `${SITE.url}/#empresa`,
  name: SITE.name,
  alternateName: 'Eventos Vórtice',
  description: 'Agencia de eventos en Toledo: team building, fiestas de empresa, despedidas, celebraciones y eventos para ayuntamientos.',
  url: SITE.url,
  logo: `${SITE.url}/img/logo-vortice.png`,
  image: ogImage,
  telephone: '+34696035857',
  email: SITE.email,
  hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Calle Alegría 48, 45008 Toledo')}`,
  knowsAbout: ['Team building', 'Fiestas de empresa', 'Despedidas de soltero', 'Eventos para ayuntamientos', 'Formación en habilidades'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.street,
    postalCode: SITE.postal,
    addressLocality: 'Toledo',
    addressRegion: 'Castilla-La Mancha',
    addressCountry: 'ES',
  },
  areaServed: [
    { '@type': 'City', name: 'Toledo' },
    { '@type': 'AdministrativeArea', name: 'Provincia de Toledo' },
    { '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
  ],
  sameAs: [SITE.instagram, SITE.facebook],
};
---
<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={'#ffffff'} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="geo.region" content="ES-CM" />
    <meta name="geo.placename" content="Toledo" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vórtice Eventos, agencia de eventos en Toledo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/img/simbolo-vortice.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/simbolo-vortice.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[80] focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded">Saltar al contenido</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <a href={SITE.whatsapp} rel="noopener" aria-label="Escríbenos por WhatsApp" class="hidden md:grid fixed bottom-6 right-6 z-40 size-16 place-items-center rounded-full bg-[#25d366] text-white shadow-[0_10px_0_-3px_#128c4a] hover:translate-y-[3px] transition-transform">
      <svg viewBox="0 0 24 24" class="size-8" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3zm4.6 12.4c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-3.2-.8a10.9 10.9 0 0 1-4.1-3.6c-.7-1-1.2-2-1.2-3s.5-1.5.7-1.7c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4l.7 1.7c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.4.7 1 1.4 1.7 1.9.7.5 1.3.8 1.6.9.3.1.5.1.6-.1l.8-.9c.2-.2.4-.2.6-.1l1.7.8c.2.1.4.2.4.3.1.2.1.7-.1 1.3z" /></svg>
    </a>
    <div class="fixed bottom-3 inset-x-3 z-40 md:hidden">
      <div class="glass rounded-full p-1.5 grid grid-cols-2 gap-1.5 shadow-2xl">
        <a href={SITE.phoneHref} class="btn btn-ghost !py-3 text-sm">Llamar</a>
        <a href={SITE.whatsapp} class="btn btn-primary !py-3 text-sm">WhatsApp</a>
      </div>
    </div>
    <script is:inline>
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var fine = matchMedia('(pointer: fine)').matches;

        // reveal
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

        // nav: scrolled state, progress, indicator, burger
        var pill = document.getElementById('pill'), bar = document.getElementById('progress');
        function onScroll() {
          var h = document.documentElement;
          pill.classList.toggle('scrolled', scrollY > 20);
          bar.style.transform = 'scaleX(' + (scrollY / Math.max(1, h.scrollHeight - innerHeight)) + ')';
        }
        addEventListener('scroll', onScroll, { passive: true }); onScroll();

        var links = pill.querySelector('.links'), ind = pill.querySelector('.nav-ind');
        if (links && ind) {
          var move = function (el) { var r = el.getBoundingClientRect(), p = links.getBoundingClientRect(); ind.style.width = r.width + 'px'; ind.style.transform = 'translateX(' + (r.left - p.left) + 'px)'; ind.style.opacity = 1; };
          links.querySelectorAll('[data-nav]').forEach(function (l) { l.addEventListener('mouseenter', function () { move(l); }); l.addEventListener('focus', function () { move(l); }); });
          links.addEventListener('mouseleave', function () { ind.style.opacity = 0; });
        }
        var burger = document.getElementById('burger'), mm = document.getElementById('mmenu');
        function closeMenu() { mm.hidden = true; burger.setAttribute('aria-expanded', 'false'); }
        burger.addEventListener('click', function () { var open = mm.hidden; mm.hidden = !open; burger.setAttribute('aria-expanded', String(open)); });
        mm.addEventListener('click', function (e) { if (e.target.closest('a')) closeMenu(); });
        addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(); });

        // spotlight cards
        document.addEventListener('pointermove', function (e) {
          var c = e.target.closest && e.target.closest('.spot');
          if (!c) return;
          var r = c.getBoundingClientRect();
          c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          c.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });

        if (reduce || !fine) return;

      })();
    </script>
  </body>
</html>
